{
  "name": "minecraft-by-xbobersonx",
  "version": "1.9.0",
  "description": "Minecraft launcher by xBobersonx",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "author": "xBobersonx",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.9",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5"
  },
  "devDependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "pl.xbobersonx.launcher",
    "productName": "Minecraft by xBobersonx",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "background.js",
      "logo.js",
      "modpack.js",
      "java.js",
      "content.js",
      "crash.js",
      "disk.js",
      "options.js",
      "modpack.json",
      "assets/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png",
      "signExecutable": false
    },
    "publish": {
      "provider": "github",
      "owner": "kubkuster-cloud",
      "repo": "minecraft-by-xBobersonx"
    },
    "nsis": {
      "artifactName": "MinecraftByXBobersonx-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Minecraft by xBobersonx"
    },
    "portable": {
      "artifactName": "MinecraftByXBobersonx-Portable.exe"
    }
  }
}
